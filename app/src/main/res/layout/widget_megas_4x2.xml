<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:gravity="center_vertical"
    android:clipToOutline="true"
    android:background="@drawable/widget_card_background"
    tools:ignore="UseAppTint">

    <!-- ROW 1: Saldo Principal on Left, "Actualizar info" Chip on Right -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:layout_marginBottom="2dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Saldo Principal"
                android:textColor="@color/widget_card_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_balance_cup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.00 CUP"
                android:textColor="@color/widget_card_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- "Actualizar info" Chip -->
        <LinearLayout
            android:id="@+id/widget_refresh_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/widget_card_chip_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@android:drawable/ic_popup_sync"
                android:tint="@color/widget_card_chip_text"
                android:contentDescription="Actualizar" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="Actualizar info"
                android:textColor="@color/widget_card_chip_text"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>

    <!-- ROW 2: Datos Disponibles (Left) & Bono Datos .CU (Right) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="2dp">

        <!-- Left Column: Datos Disponibles -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Datos Disponibles"
                android:textColor="@color/widget_card_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/widget_data_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0.00 GB"
                    android:textColor="@color/widget_card_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Badge for days remaining -->
                <TextView
                    android:id="@+id/widget_data_days_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/widget_card_badge_bg"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="1.5dp"
                    android:textColor="@color/widget_card_text_primary"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Right Column: Bono Datos .CU -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bono Datos .CU"
                android:textColor="@color/widget_card_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/widget_bonus_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0.00 GB"
                    android:textColor="@color/widget_card_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Badge for days remaining -->
                <TextView
                    android:id="@+id/widget_bonus_days_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/widget_card_badge_bg"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="1.5dp"
                    android:textColor="@color/widget_card_text_primary"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ROW 3: Llamadas (Voz) (Left) & Mensajes (Right) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="2dp">

        <!-- Left Column: Llamadas (Voz) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Llamadas (Voz)"
                android:textColor="@color/widget_card_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/widget_calls_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0 Min"
                    android:textColor="@color/widget_card_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Badge for days remaining -->
                <TextView
                    android:id="@+id/widget_calls_days_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/widget_card_badge_bg"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="1.5dp"
                    android:textColor="@color/widget_card_text_primary"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Right Column: Mensajes -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mensajes"
                android:textColor="@color/widget_card_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/widget_sms_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0 SMS"
                    android:textColor="@color/widget_card_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Badge for days remaining -->
                <TextView
                    android:id="@+id/widget_sms_days_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/widget_card_badge_bg"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="1.5dp"
                    android:textColor="@color/widget_card_text_primary"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ROW 4: Footer (Puede recargar el... + Days badge) -->
    <LinearLayout
        android:id="@+id/widget_recharge_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="2dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@android:drawable/ic_menu_my_calendar"
            android:tint="@color/widget_card_text_secondary"
            android:contentDescription="Icono Recarga" />

        <TextView
            android:id="@+id/widget_recharge_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="Puede recargar el --"
            android:textColor="@color/widget_card_text_secondary"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- Badge for days remaining for next recharge -->
        <TextView
            android:id="@+id/widget_recharge_days_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_card_badge_bg"
            android:paddingHorizontal="4dp"
            android:paddingVertical="1.5dp"
            android:textColor="@color/widget_card_text_primary"
            android:textSize="9sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Hidden legacy views to preserve layout ID compilation -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:visibility="gone">
        <ProgressBar
            android:id="@+id/widget_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <TextView
            android:id="@+id/widget_last_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <TextView
            android:id="@+id/widget_sub_details"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <TextView
            android:id="@+id/widget_expiration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

</LinearLayout>
