<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="check_balance"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_balance"
        android:shortcutShortLabel="@string/shortcut_check_balance_short"
        android:shortcutLongLabel="@string/shortcut_check_balance_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.ams.megascu"
            android:targetClass="com.ams.megascu.MainActivity">
            <extra android:name="shortcut_action" android:value="check_balance" />
        </intent>
    </shortcut>

    <shortcut
        android:shortcutId="check_data"
