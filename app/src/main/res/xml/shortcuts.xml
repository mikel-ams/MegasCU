            <extra android:name="shortcut_action" android:value="check_data" />
        </intent>
    </shortcut>

    <shortcut
        android:shortcutId="open_history"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_history"
        android:shortcutShortLabel="@string/shortcut_open_history_short"
